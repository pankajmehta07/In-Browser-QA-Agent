{
  "name": "in-browser-qa-agent",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/target-app",
    "apps/dashboard",
    "server"
  ],
  "scripts": {
    "dev:target": "npm run dev -w apps/target-app",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "dev:server": "npm run dev -w server",
    "dev": "concurrently \"npm run dev:target\" \"npm run dev:dashboard\" \"npm run dev:server\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
